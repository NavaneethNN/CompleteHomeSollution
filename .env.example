# Set to onlinepay only after the OnlinePay test credentials below are configured.
NEXT_PUBLIC_PAYMENT_GATEWAY=payway
PAYMENT_GATEWAY=payway

# Westpac OnlinePay Checkout API — CST test environment
ONLINEPAY_MODE=test
ONLINEPAY_USER_UID=
ONLINEPAY_API_KEY=
ONLINEPAY_ENTITY_ID=
ONLINEPAY_PPC_ID=
ONLINEPAY_3DS_ID=
# Generate a distinct 32+ character random value. It is used only between the
# webhook handler and the internal settlement request; never expose it to clients.
ONLINEPAY_WEBHOOK_SECRET=
# Required for HPP return URLs; use an HTTPS tunnel (for example ngrok) locally.
NEXT_PUBLIC_APP_URL=
# Enable only on the public production domain after verifying canonical URLs.
SITE_INDEXING_ENABLED=false
# In OnlinePay Dashboard > Administration > Advanced Settings > Notifications,
# add `${NEXT_PUBLIC_APP_URL}/api/webhooks/onlinepay` with the full payload for
# "Checkout - Transaction succeeded" and "Checkout - Transaction failed".

# OnlinePay requires HTTPS even in test mode. Must serve this application.
ONLINEPAY_RETURN_BASE_URL=

# Required in production for shared abuse limits across application instances.
# Development and tests use an in-process fallback; production fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production release preflight also requires these and the selected gateway's
# credentials. Run `npm run release:preflight` against staging before serving.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
CRON_SECRET=
SENTRY_DSN=
BREVO_API_KEY=
