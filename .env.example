# OnlinePay is the intended gateway. Checkout stays unavailable until its
# credentials and the production dependencies below are configured.
NEXT_PUBLIC_PAYMENT_GATEWAY=onlinepay
PAYMENT_GATEWAY=onlinepay

# Westpac OnlinePay Checkout API — CST test environment
ONLINEPAY_MODE=test
ONLINEPAY_USER_UID=
ONLINEPAY_API_KEY=
ONLINEPAY_ENTITY_ID=
ONLINEPAY_PPC_ID=
ONLINEPAY_3DS_ID=
# Generate a distinct 32+ character random value. It is used only between the
# webhook handler and the internal settlement request; never expose it to clients.
ONLINEPAY_WEBHOOK_SECRET=
# Required for HPP browser return URLs. Use https://localhost:3000 for local testing.
# A public tunnel is needed only to receive OnlinePay webhooks on localhost.
NEXT_PUBLIC_APP_URL=
# Enable only on the public production domain after verifying canonical URLs.
SITE_INDEXING_ENABLED=false
# In OnlinePay Dashboard > Administration > Advanced Settings > Notifications,
# add `${NEXT_PUBLIC_APP_URL}/api/webhooks/onlinepay` with the full payload for
# "Checkout - Transaction succeeded" and "Checkout - Transaction failed".

# OnlinePay requires HTTPS even in test mode. Must serve this application.
# npm run dev serves https://localhost:3000 and sets this URL automatically.
ONLINEPAY_RETURN_BASE_URL=

# Ship123 is the only new-checkout shipping provider. Named Australia Post
# products are allowed through Ship123; no direct Australia Post API is used.
SHIP_123_API_KEY=
# Required before an administrator can create a Ship123 label for a paid order.
SHIP123_SENDER_NAME=
SHIP123_SENDER_LINE1=
# Alternative to SHIP123_SENDER_LINE1 (use either one):
# SHIP123_SENDER_STREET=
SHIP123_SENDER_LINE2=
SHIP123_SENDER_SUBURB=
SHIP123_SENDER_STATE=
SHIP123_SENDER_POSTCODE=
SHIP123_SENDER_PHONE=
SHIP123_SENDER_EMAIL=

# Required in production for shared abuse limits across application instances.
# Development and tests use an in-process fallback; production fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production release preflight also requires these and the selected gateway's
# credentials. Run `npm run release:preflight` against staging before serving.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
CRON_SECRET=
SENTRY_DSN=
BREVO_API_KEY=
