    "@tiptap/starter-kit": "^3.31.3",
    "@types/sanitize-html": "^2.16.1",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.175",
    "algoliasearch": "^5.52.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
