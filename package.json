    "@react-google-maps/api": "^2.20.8",
    "@sentry/nextjs": "^10.51.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
