{
  "name": "complete-home-sollution",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "npm run dev:http",
    "dev:http": "AUTH_URL=http://localhost:3000 NEXTAUTH_URL=http://localhost:3000 NEXT_PUBLIC_APP_URL=http://localhost:3000 next dev --turbopack --port 3000",
    "dev:tunnel": "next dev --turbopack --port 3000",
    "dev:https": "next dev --turbopack --port 3000 --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-products": "tsx prisma/seed-products.ts",
    "test:checkout": "node --import tsx --test tests/*.test.ts",
    "check:checkout": "node --import tsx scripts/check-checkout.ts",
    "check:onlinepay": "node --import tsx scripts/check-onlinepay-sandbox.ts",
    "check:order-transaction": "node --import tsx scripts/check-order-transaction.ts",
    "check:membership": "node --import tsx scripts/check-membership-transaction.ts",
    "check:release-config": "node --import tsx scripts/check-release-config.ts",
    "release:preflight": "npm run check:release-config && npm run db:deploy && npm run check:checkout"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.61",
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
