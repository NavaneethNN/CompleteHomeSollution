    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "next": {
      "postcss": "$postcss"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "tsx": {
      "esbuild": "0.28.1"
    }
  }
}
