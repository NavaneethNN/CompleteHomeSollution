generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TestStatus {
  PENDING
  PASSED
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  passwordHash  String?
  role        Role      @default(CUSTOMER)
  isMember         Boolean   @default(false)
  memberSince      DateTime?
  membershipExpiry DateTime?
  mfaEnabled  Boolean   @default(false)
  mfaSecret   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders             Order[]
  reviews            Review[]
  addresses          Address[]
  cart               CartItem[]
  blogPosts          BlogPost[]
  blogLikes          BlogLike[]
  membershipPayments MembershipPayment[]
  userCoupons        UserCoupon[] // Track coupon usage

  // NextAuth required fields
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @db.Text
  basePrice    Float    @default(0) // Base price before variants
  comparePrice Float?
  memberPrice  Float?
  stock        Int      @default(0) // Total stock across all variants
  sku          String   @unique // Base SKU
  images       String[] // Default product images
  material     String?
  roomType     String?
  isActive     Boolean  @default(true)
  hasVariants  Boolean  @default(false) // Whether this product uses variant system
  categoryId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Shipping dimensions (in cm)
  weight       Float?   // Weight in kg
  length       Float?   // Length in cm
  width        Float?   // Width in cm
  height       Float?   // Height in cm

  category          Category           @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  variantAttributes VariantAttribute[] // Custom variant categories (Color, Size, etc.)
  productVariants   ProductVariant[]   // Actual sellable variants with prices
  couponProducts    CouponProduct[]    // Coupons applicable to this product

  embedding Unsupported("vector(1536)")?

  @@index([categoryId])
  @@index([slug])
}

// Defines variant categories for a product (e.g., Color, Size, Material)
model VariantAttribute {
  id          String         @id @default(cuid())
  name        String         // Display name: "Color", "Size", "Material"
  displayOrder Int           @default(0) // Order to show in UI
  isPrimary   Boolean        @default(false) // Primary attribute whose values share images
  productId   String
  createdAt   DateTime       @default(now())

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantValues VariantValue[] // Options under this attribute

  @@index([productId])
}

// Defines specific variant options (e.g., Red, Blue, Large, Leather)
model VariantValue {
  id                 String           @id @default(cuid())
  value              String           // Display value: "Red", "Large", "Leather"
  hexCode            String?          // For color variants (optional)
  images             String[]         // Shared images for this value when it is primary
  variantAttributeId String
  createdAt          DateTime         @default(now())

  variantAttribute VariantAttribute @relation(fields: [variantAttributeId], references: [id], onDelete: Cascade)
  
  // Join table relationships
  productVariantValues ProductVariantValue[]

  @@index([variantAttributeId])
}

// The actual sellable product variant (combination of variant values)
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique // Unique SKU for this variant
  price        Float    // Specific price for this variant combination
  comparePrice Float?
  memberPrice  Float?
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Shipping dimensions (in cm) - overrides product dimensions if set
  weight       Float?   // Weight in kg
  length       Float?   // Length in cm
  width        Float?   // Width in cm
  height       Float?   // Height in cm

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  VariantImage[]       // Images specific to this variant
  values  ProductVariantValue[] // Links to the variant values (Color: Red, Size: Large)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
}

// Join table: Links ProductVariant to VariantValue combinations
model ProductVariantValue {
  id               String @id @default(cuid())
  productVariantId String
  variantValueId   String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  variantValue   VariantValue   @relation(fields: [variantValueId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, variantValueId])
  @@index([productVariantId])
  @@index([variantValueId])
}

// Images specific to a product variant
model VariantImage {
  id               String @id @default(cuid())
  productVariantId String
  url              String
  alt              String?
  displayOrder     Int    @default(0)
  createdAt        DateTime @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  image    String?
  products Product[]
  couponCategories CouponCategory[] // Coupons applicable to this category
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus @default(PENDING)
  addressId       String
  subtotal        Float
  shippingCost    Float
  tax             Float
  discount        Float       @default(0) // Coupon discount amount
  total           Float
  stripePaymentId String?
  trackingNumber  String?
  carrier         String?
  // Coupon fields
  couponId        String?
  couponCode      String?     // Store the code used at time of order
  // Refund / cancellation fields
  refundRequested   Boolean   @default(false)
  refundReason      String?
  refundAmount      Float?
  refundedAt        DateTime?
  refundStripeId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  coupon  Coupon?     @relation(fields: [couponId], references: [id])
  userCoupon UserCoupon? // Link to user-coupon usage record

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([stripePaymentId])
  @@index([refundRequested])
  @@index([couponId])
}

// ─── Coupon Models ───────────────────────────────────────────────────────────

enum CouponType {
  GLOBAL       // Applies to all products
  PRODUCT      // Applies to specific products only
  CATEGORY     // Applies to specific categories only
}

enum CouponDiscountType {
  PERCENTAGE   // Percentage off (e.g., 10%)
  FIXED        // Fixed amount off (e.g., $10)
}

enum CouponMemberEligibility {
  ALL          // Available to all users (members and non-members)
  MEMBERS_ONLY // Available to members only
  NON_MEMBERS  // Available to non-members only
}

model Coupon {
  id              String            @id @default(cuid())
  code            String            @unique // e.g., "SAVE10", "SUMMER2024"
  name            String            // Display name
  description     String?           @db.Text
  type            CouponType        // GLOBAL, PRODUCT, CATEGORY
  discountType    CouponDiscountType // PERCENTAGE or FIXED
  discountValue   Float             // Percentage (e.g., 10) or fixed amount (e.g., 10.00)
  minOrderAmount  Float?            // Minimum order amount to use coupon
  maxDiscount     Float?            // Maximum discount cap (for percentage coupons)
  usageLimit      Int?              // Total usage limit across all users
  usageCount      Int               @default(0) // Current usage count
  perUserLimit    Int?              // Max uses per user
  memberEligibility CouponMemberEligibility @default(ALL) // Who can use this coupon
  startDate       DateTime?         // When coupon becomes valid
  endDate         DateTime?         // When coupon expires
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations for specific coupon types
  products        CouponProduct[]
  categories      CouponCategory[]
  orders          Order[]
  userCoupons     UserCoupon[] // Track per-user usage

  @@index([code])
  @@index([isActive])
  @@index([type])
}

// Join table: Coupons for specific products
model CouponProduct {
  id        String   @id @default(cuid())
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([couponId])
  @@index([productId])
}

// Join table: Coupons for specific categories
model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([couponId])
  @@index([categoryId])
}

// Track per-user coupon usage for enforcing perUserLimit
model UserCoupon {
  id        String   @id @default(cuid())
  userId    String
  couponId  String
  orderId   String   @unique // One coupon use per order
  usedAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId, orderId])
  @@index([userId])
  @@index([couponId])
  @@index([orderId])
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String? // Optional: only if product has variants
  quantity         Int
  unitPrice        Float
  variantSummary   String? // Summary of selected variants (e.g., "Color: Red, Size: Large")

  order          Order           @relation(fields: [orderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

model Address {
  id       String  @id @default(cuid())
  userId   String?
  name     String
  phone    String
  line1    String
  line2    String?
  suburb   String
  state    String
  postcode String
  country  String  @default("AU")

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?  @db.Text
  images    String[] @default([])
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model CartItem {
  id               String  @id @default(cuid())
  userId           String
  productId        String
  productVariantId String? // Optional: only if product has variants
  quantity         Int
  variantSummary   String? // Summary of selected variants

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([userId, productId, productVariantId])
  @@index([productVariantId])
}

model MembershipPlan {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  price           Float    // AUD price
  durationDays    Int      // e.g. 365 for annual, 30 for monthly
  discountPercent Float    @default(0) // % discount members get on products
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false) // the plan shown in checkout
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MembershipPayment {
  id              String   @id @default(cuid())
  userId          String
  planId          String?
  amount          Float
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockAlert {
  id        String   @id @default(cuid())
  email     String
  productId String
  createdAt DateTime @default(now())

  @@unique([email, productId])
}

model TestResult {
  id        String     @id @default(cuid())
  testId    String     @unique
  suite     String
  status    TestStatus @default(PENDING)
  notes     String?    @db.Text
  comments  String?    @db.Text
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

// ─── Blog Models ────────────────────────────────────────────────────────────────

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  color       String?  // hex color for UI
  posts       BlogPost[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?  // hex color for UI
  posts     BlogPostTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text // Rich HTML content
  coverImage  String?   // URL to cover image
  status      String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  featured    Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  tags        BlogPostTag[]
  likes       BlogLike[]
  seoTitle    String?
  seoDescription String? @db.Text
  readTime    Int?      // estimated reading time in minutes
  viewCount   Int       @default(0)
  likeCount   Int       @default(0)
  isMemberOnly Boolean  @default(false)
  socialLinks Json?     // Store social media links as JSON
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([isMemberOnly])
  @@index([featured])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}
